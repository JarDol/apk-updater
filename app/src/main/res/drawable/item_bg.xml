<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FF1E3A5F" /><corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#FF4FC3F7" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#FF1565C0" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FF161B22" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
